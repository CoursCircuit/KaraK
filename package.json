{
  "name": "karak",
  "version": "1.3.0",
  "description": "Jeu pédagogique type N'oubliez pas les paroles, 100% local",
  "main": "main.js",
  "author": "CoursCircuit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac --arm64"
  },
  "devDependencies": {
    "ajv-keywords": "^5.1.0",
    "bluebird": "^3.7.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "fs-extra": "^11.2.0"
  },
  "overrides": {
    "crc": "3.8.0"
  },
  "build": {
    "appId": "com.karak.app",
    "productName": "KaraK",
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "dist/1.3.0"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "examples/**/*",
      "assets/**/*",
      "README.md",
      "!assets/alignment/**/*",
      "alignment.js",
      "LICENSE"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "15.0",
      "identity": "-",
      "notarize": false,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-arm64.${ext}",
      "sign": "./scripts/sign-local.js",
      "icon": "assets/icon.icns"
    },
    "extraResources": [
      {
        "from": "assets/alignment",
        "to": "alignment",
        "filter": [
          "whisper-cli",
          "ggml-large-v3-turbo-q5_0.bin",
          "LICENSE-*.txt"
        ]
      }
    ],
    "dmg": {
      "title": "KaraK 1.3.0",
      "icon": "assets/icon.icns",
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
